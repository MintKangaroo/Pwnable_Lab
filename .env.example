# Development-only Compose values. Replace them before any shared deployment.
POSTGRES_DB=pwnpilot
POSTGRES_USER=pwnpilot
POSTGRES_PASSWORD=<set-a-local-development-password>
PWNPILOT_PORT=8080
PLAB_MAX_UPLOAD_BYTES=33554432
PLAB_MAX_CRASH_LOG_BYTES=2097152
PLAB_MAX_CORE_DUMP_BYTES=67108864
PLAB_MAX_CRASH_LOG_LINES=100000
PLAB_MAX_CRASH_STACK_ENTRIES=4096
PLAB_MAX_CORE_NOTES=4096
PLAB_MAX_CORE_NOTE_BYTES=8388608

# 동적 오프셋 확정 샌드박스 (Phase 6). 신뢰할 수 없는 바이너리를 실행하므로
# 기본 비활성. 프로덕션에서는 executor=container 로 network-disabled 일회용
# 컨테이너에서만 실행할 것 (docs/AUTO_EXPLOIT_SANDBOX.md).
# PLAB_SANDBOX_EXECUTION_ENABLED=false
# PLAB_SANDBOX_EXECUTOR=inprocess          # inprocess | container
# PLAB_SANDBOX_CONTAINER_IMAGE=pwnpilot-sandbox
# PLAB_SANDBOX_CONTAINER_RUNTIME=          # e.g. runsc (gVisor)
# PLAB_SANDBOX_ISOLATION_MARKER=           # inprocess 모드에서 격리 마커 경로

# Future production/auth/AI placeholders. They are intentionally unused today.
PLAB_AUTH_SECRET_KEY=<set-in-secret-manager>
OPENAI_API_KEY=<set-in-secret-manager>
OLLAMA_BASE_URL=<explicit-local-endpoint>
