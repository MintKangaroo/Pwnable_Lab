# All settings use the PLAB_ prefix.
PLAB_APP_NAME=PwnPilot
PLAB_ENVIRONMENT=development
PLAB_MAX_UPLOAD_BYTES=33554432
PLAB_UPLOAD_CHUNK_BYTES=1048576
PLAB_STORAGE_DIR=./_storage
PLAB_DATABASE_URL=sqlite:///./pwnable_lab.db
PLAB_AUTO_CREATE_SCHEMA=true
PLAB_MAX_DISASM_INSTRUCTIONS=20000
PLAB_MAX_GADGETS=2000
PLAB_MAX_GADGET_DEPTH=5
PLAB_MAX_STRINGS=20000
PLAB_HEX_PAGE_SIZE=512
PLAB_MAX_CYCLIC_LENGTH=65536
PLAB_CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'
PLAB_LOG_LEVEL=INFO

# Reserved placeholders for later phases. Do not commit real credentials.
# PLAB_AUTH_SECRET_KEY=<set-in-server-secret-store>
# OPENAI_API_KEY=<set-in-server-secret-store>
# OLLAMA_BASE_URL=<explicit-local-endpoint>
